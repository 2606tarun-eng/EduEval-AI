# EduEval AI - Environment Variables Template
# Copy this file to backend/.env and populate your API credentials

LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Primary model. Tried first; the built-in fallback list is used if it fails.
LLM_MODEL=gemini-3.5-flash
# Retries on the SAME model before rotating to a fallback (429 = rate limited).
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2.0
# Seconds a quota-exhausted model is skipped for.
LLM_COOLDOWN_SECONDS=300

# OCR (OCR.Space). Free tier: 25,000 requests/month.
# "helloworld" is the public sandbox key — get a real one at https://ocr.space/ocrapi
OCR_API_KEY=helloworld
# Engine 2 handles handwritten exam scripts reasonably well.
OCR_ENGINE=2
# Only honoured on a real (paid-tier) OCR.Space key; the sandbox key returns HTTP 400.
OCR_IS_HANDWRITTEN=false
OCR_LANGUAGE=eng
